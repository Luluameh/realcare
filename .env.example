# =============================================================================
# StillHere — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git!
# =============================================================================

# ── AWS Region ───────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# ── AWS Credentials (IAM Access Key — for Strands SDK / boto3) ───────────────
# Get from: AWS Console → IAM → Security Credentials → Create access key
# Use case: "Local code"
AWS_ACCESS_KEY_ID=AKIA...your_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# ── Bedrock Model Selection ───────────────────────────────────────────────────
# Primary model (Claude Haiku 4.5 — fastest, cheapest, confirmed Active)
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
# Fallback model if primary has capacity issues
BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-sonnet-4-6

# ── Agent Mode ────────────────────────────────────────────────────────────────
# Set to 'false' to use live Amazon Bedrock
# Set to 'true' to use the built-in high-fidelity local simulator (no AWS needed)
USE_MOCK_AGENT=false

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
HOST=127.0.0.1
